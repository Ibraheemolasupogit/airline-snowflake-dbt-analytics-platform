[sqlfluff]
dialect = snowflake
templater = dbt
sql_file_exts = .sql
max_line_length = 120
# Milestone 18's int_billing_exceptions.sql unions 14 heavily-documented detection-rule CTEs into
# one file (matching the established union-model pattern from int_booking_charge_components /
# int_invoice_charge_comparison) and legitimately exceeds the 20000-byte default parser-lock limit
# -- raised so it is actually linted rather than silently skipped, not to permit unbounded growth.
large_file_skip_byte_limit = 40000
exclude_rules = RF04
exclude_paths =
    .venv
    dbt_packages
    target

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .
profile = airline_snowflake_dbt_analytics_platform
target = dev

[sqlfluff:templater:jinja]
# The dbt templater needs a live Snowflake connection, which CI/offline linting does not have
# (see .github/workflows/ci.yml, which lints with --templater jinja instead). SQLFluff's jinja
# templater has built-in mocks for dbt's own ref()/source()/config()/var()/is_incremental(), but
# not for package macros. dim_aircraft, dim_aircraft_type, dim_airline, dim_airport, dim_flight,
# and dim_route call dbt_utils.generate_surrogate_key(), so sqlfluff_libs/dbt_utils.py provides an
# offline-lint-only shim for that one macro, loaded here and exposed in templates as dbt_utils.
library_path = sqlfluff_libs
# Milestone 13's pricing models call the project macro convert_currency() (macros/convert_currency.sql)
# bare, with no namespace, matching real dbt project-macro call syntax exactly. Unlike dbt_utils
# above (a package macro, always namespaced), a project macro cannot be shimmed via library_path
# (which only exposes namespaced python modules). load_macros_from_path loads the real Jinja macro
# file directly instead -- no shim/duplicate implementation needed, since the macro itself contains
# no dbt-specific calls (no ref()/source()/config()).
load_macros_from_path = macros

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = true
ignore_comment_clauses = true
